rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BINDNEXUS SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a strict Ownership-based Access Control (OBAC) model. 
     * Security is enforced by verifying that the 'ownerId' field on every document 
     * matches the authenticated user's UID.
     * 
     * DATA STRUCTURE:
     * The application uses a flat, top-level collection structure for scalability:
     * - /nuclei/{nucleusId}
     * - /bindCodes/{bindCodeId}
     * - /bindOperations/{operationId}
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: To avoid expensive and complex get() calls, 
     *    the 'ownerId' is denormalized onto every document. This allows rules to 
     *    independently verify access for any entity (Nucleus, BindCode, or 
     *    BindOperation) in a single operation.
     * 2. Prototyping Flexibility: While authorization is strictly enforced (who 
     *    can access), the internal data schema (types, optional fields) is kept 
     *    flexible to allow for rapid iteration.
     * 3. Relational Integrity: On creation, the rules force the 'ownerId' to 
     *    match the user's UID. On update, 'ownerId' is made immutable to prevent 
     *    ownership hijacking.
     * 4. Secure Lists: All list operations require the user to be signed in. 
     *    Developers must apply an 'ownerId' filter in their client-side queries 
     *    to comply with Firestore's query-as-authorization behavior.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the provided UID matches the authenticated user's UID.
     * @param userId The UID to compare against the current session.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Combines existence check and ownership check for existing documents.
     * Used for update and delete operations to ensure the document exists before acting.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // The 'isValidOwnership' function was unused and its logic was already
    // directly implemented in the create and update rules.
    // Removing it resolves the "Unused function" and "Invalid variable name" warnings.

    // --- COLLECTION RULES ---

    /**
     * @description Rules for Nucleus documents, representing core projects.
     * @path /nuclei/{nucleusId}
     * @allow (create) if auth.uid matches request.resource.data.ownerId.
     * @deny (update) if trying to change the ownerId field.
     * @principle Ownership-based access with denormalized ownerId.
     */
    match /nuclei/{nucleusId} {
      allow get: if isOwner(resource.data.ownerId);
      allow list: if isSignedIn(); // Query must include: .where('ownerId', '==', auth.uid)
      
      allow create: if isSignedIn() && 
                    request.resource.data.ownerId == request.auth.uid;
      
      allow update: if isExistingOwner(resource.data.ownerId) && 
                    request.resource.data.ownerId == resource.data.ownerId;
      
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Rules for BindCode documents. Ownership is denormalized from the parent Nucleus.
     * @path /bindCodes/{bindCodeId}
     * @allow (get) if the user's UID matches the document's ownerId.
     * @deny (delete) if the user is not the owner of the document.
     * @principle Authorization Independence via denormalization of ownerId.
     */
    match /bindCodes/{bindCodeId} {
      allow get: if isOwner(resource.data.ownerId);
      allow list: if isSignedIn(); // Query must include: .where('ownerId', '==', auth.uid)
      
      allow create: if isSignedIn() && 
                    request.resource.data.ownerId == request.auth.uid;
      
      allow update: if isExistingOwner(resource.data.ownerId) && 
                    request.resource.data.ownerId == resource.data.ownerId;
      
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Rules for BindOperation logs. Ownership is denormalized from the parent Nucleus.
     * @path /bindOperations/{operationId}
     * @allow (create) if the user sets their own UID as the ownerId.
     * @deny (list) if the user is not authenticated.
     * @principle Immutable relational fields for audit log integrity.
     */
    match /bindOperations/{operationId} {
      allow get: if isOwner(resource.data.ownerId);
      allow list: if isSignedIn(); // Query must include: .where('ownerId', '==', auth.uid)
      
      allow create: if isSignedIn() && 
                    request.resource.data.ownerId == request.auth.uid;
      
      // Updates are typically restricted for audit logs, but permitted here for prototyping.
      allow update: if isExistingOwner(resource.data.ownerId) && 
                    request.resource.data.ownerId == resource.data.ownerId;
      
      allow delete: if isExistingOwner(resource.data.ownerId);
    }
  }
}