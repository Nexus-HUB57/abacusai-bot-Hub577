rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BINDNEXUS SECURITY RULES (PROTOTYPING MODE)
     *
     * Core Philosophy:
     * This ruleset enforces a strict hierarchical user-ownership model. Access is primarily 
     * determined by the user's presence in the document path and verified against denormalized 
     * ownership fields within the documents.
     *
     * Data Structure:
     * All data is nested under the `/users/{userId}/` path. This creates a clear boundary 
     * for user-specific data and simplifies query security through Query-Able Paths (QAPs).
     *
     * Key Security Decisions:
     * 1. Authorization Independence: Every document (Nuclei, BindCodes, History) contains 
     *    denormalized relational IDs (ownerId, nucleusId, bindCodeId). This allows rules to 
     *    validate access without performing expensive 'get()' lookups on parent documents.
     * 2. Strict Path Consistency: Rules enforce that the internal document fields (like 'id' 
     *    or 'nucleusId') must strictly match the Firestore path segments during creation.
     * 3. Prototyping Flexibility: While authorization is strictly enforced, the rules do not 
     *    validate data types or non-relational fields (e.g., descriptions, names, tags) to 
     *    allow for rapid front-end iteration.
     * 4. State Safety: All update and delete operations require the document to exist 
     *    and the requester to be the verified owner.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    // Checks if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the authenticated user's UID matches the provided userId.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Combines ownership check with a resource existence check for updates/deletes.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Validates that critical relational fields are not changed during an update.
    function isImmutable(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for managing a user's core projects (Nuclei).
     * @path /users/{userId}/nuclei/{nucleusId}
     * @allow Authenticated user creates a Nucleus under their own path (create).
     * @deny User A attempts to list or update a Nucleus under User B's path.
     * @principle Enforces path-based ownership and validates relational ID consistency.
     */
    match /users/{userId}/nuclei/{nucleusId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == nucleusId;
      allow update: if isExistingOwner(userId) && isImmutable('id');
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for bind codes associated with a specific Nucleus.
       * @path /users/{userId}/nuclei/{nucleusId}/bindCodes/{bindCodeId}
       * @allow Owner of the Nucleus creates a new BindCode (create).
       * @deny Unauthenticated user or non-owner attempts to read bind codes.
       * @principle Denormalized nucleusId is used to verify path consistency without a get().
       */
      match /bindCodes/{bindCodeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == bindCodeId && request.resource.data.nucleusId == nucleusId;
        allow update: if isExistingOwner(userId) && isImmutable('id') && isImmutable('nucleusId');
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for the chronological history of a specific bind code.
         * @path /users/{userId}/nuclei/{nucleusId}/bindCodes/{bindCodeId}/history/{historyEntryId}
         * @allow Owner logs a new operation attempt for their bind code (create).
         * @deny Anyone attempting to modify historical logs after creation (update).
         * @principle Ensures deep subcollection access is restricted to the root owner.
         */
        match /history/{historyEntryId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.id == historyEntryId && request.resource.data.bindCodeId == bindCodeId && request.resource.data.nucleusId == nucleusId;
          allow update: if isExistingOwner(userId) && isImmutable('id') && isImmutable('bindCodeId') && isImmutable('nucleusId');
          allow delete: if isExistingOwner(userId);
        }
      }
    }

    // --- GLOBAL DENY ---
    // Explicitly deny any access to documents not covered by the match patterns above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}