rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal rule for user-owned data: A user can read/write their own document and any subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}