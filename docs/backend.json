
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information including credits and roles.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "monthlyCredits": { "type": "number" },
        "creditsUsed": { "type": "number" },
        "creditResetDate": { "type": "string", "format": "date-time" },
        "lastSignedIn": { "type": "string", "format": "date-time" }
      }
    },
    "Nucleus": {
      "title": "Nucleus",
      "description": "A processing unit within the BindNexus network.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["primary", "secondary", "tertiary"] },
        "status": { "type": "string", "enum": ["online", "syncing", "offline", "error"] },
        "syncProgress": { "type": "number" },
        "lastHeartbeat": { "type": "string", "format": "date-time" },
        "lastSyncAt": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" }
      },
      "required": ["name", "type", "userId"]
    },
    "BindCode": {
      "title": "Bind Code",
      "description": "A secure code used for linking system components.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "format": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "used", "expired", "revoked"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "usedAt": { "type": "string", "format": "date-time" },
        "usedBy": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["code", "createdBy"]
    },
    "BindHistory": {
      "title": "Bind History",
      "description": "Audit log of bind operations.",
      "type": "object",
      "properties": {
        "bindCodeId": { "type": "string" },
        "nucleusId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "sent", "confirmed", "failed"] },
        "telegramResponse": { "type": "string" },
        "errorMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      }
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "History of user actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreditHistory": {
      "title": "Credit History",
      "description": "History of credit consumption.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "creditsUsed": { "type": "number" },
        "description": { "type": "string" },
        "bindCodeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and credit tracking."
    },
    "/nuclei/{nucleusId}": {
      "schema": "Nucleus",
      "description": "Collection of system nuclei."
    },
    "/bindCodes/{bindCodeId}": {
      "schema": "BindCode",
      "description": "Collection of generated bind codes."
    },
    "/bindHistory/{historyId}": {
      "schema": "BindHistory",
      "description": "Audit logs for bind events."
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "General activity logs."
    },
    "/creditHistory/{historyId}": {
      "schema": "CreditHistory",
      "description": "Credit usage logs."
    }
  }
}
